{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lte/home-reviews",
	"title": "Home: Reviews (What members say.)",
	"category": "lte",
	"icon": "layout",
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": false
	},
	"attributes": {
		"f1": {
			"type": "string",
			"default": "What members <em>say.</em>"
		},
		"r1": {
			"type": "array",
			"default": [
				{
					"k1": "Placeholder review",
					"k2": "[Add a real, verified member review. Get written permission before publishing.]",
					"k3": "[Member first name]",
					"k4": "Member since [month, year]"
				},
				{
					"k1": "Placeholder review",
					"k2": "[Add a real, verified member review about what they learned, not about profits.]",
					"k3": "[Member first name]",
					"k4": "Member since [month, year]"
				},
				{
					"k1": "Placeholder review",
					"k2": "[Add a real, verified member review in their own words.]",
					"k3": "[Member first name]",
					"k4": "Member since [month, year]"
				}
			]
		},
		"f2": {
			"type": "string",
			"default": "Reviews describe individual experiences. They are not typical results and do not guarantee any outcome."
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
